{
  "name": "blackbox-codex-patcher",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A Vencord-style runtime mod loader for the Codex desktop app.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ijsbeerdev/blackbox.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "package": "powershell -ExecutionPolicy Bypass -File scripts/package-release.ps1",
    "patch": "powershell -ExecutionPolicy Bypass -File scripts/patch.ps1",
    "unpatch": "powershell -ExecutionPolicy Bypass -File scripts/unpatch.ps1"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
