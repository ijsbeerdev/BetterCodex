---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Blackbox",
  description = "A local-first, infinitely customizable interface for Codex.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("blackbox-active-theme-v1") || "galaxy";
          const enabled = JSON.parse(localStorage.getItem("blackbox-library-enabled-v1") || "[]");
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.quietComposer = enabled.includes("quiet-composer") ? "true" : "false";
        } catch {
          document.documentElement.dataset.theme = "galaxy";
        }
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
